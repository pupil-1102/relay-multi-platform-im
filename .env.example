# ---- core ----
APP_NAME=Relay · 多平台消息台
ENV=dev
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
# base64 urlsafe 32-byte Fernet key. Empty = derive from SECRET_KEY.
ENCRYPTION_KEY=
MAX_FILE_MB=50

# ---- demo / mock (default: fully working without platform credentials) ----
DEMO_MODE=true
DEV_LOGIN=true
SEED_DEMO=true
MOCK_LATENCY_MS=0
ENABLE_REAL_CHANNELS=false
# true = run user-token mirrors (Feishu/DingTalk) for every connected account.
# Bot/app channels (Feishu WS, DingTalk Stream, WeCom aibot) remain single-owner.
MULTI_USER_CHANNELS=false

# ---- accounts ----
# Self-service email+password registration (POST /api/auth/register).
ALLOW_REGISTRATION=true
# Inbound messages may trigger keyword/fallback rules from the "自动回复" page.
AUTO_REPLY_ENABLED=true
# true = attach a brand-new platform login (identity not bound yet) to the only
# existing user. Set false when you run several registered accounts.
SINGLE_OPERATOR=true

# ---- Feishu ----
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/api/auth/feishu/callback
FEISHU_OAUTH_SCOPE=offline_access task:task:read task:task:write im:message contact:user.base:readonly
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Personal-account mirror: poll the operator's own chats with user OAuth.
# Requires im:chat:readonly + im:message.p2p_msg:get_as_user.
FEISHU_USER_MIRROR_ENABLED=false
FEISHU_USER_MIRROR_INTERVAL=8

# ---- DingTalk ----
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
DINGTALK_CORP_ID=
DINGTALK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/dingtalk/callback
DINGTALK_DWS_ENABLED=false
DINGTALK_DWS_COMMAND=dws
DINGTALK_DWS_CONFIG_DIR=
DINGTALK_DWS_DISABLE_KEYCHAIN=false
DINGTALK_DWS_PROFILE=default
DINGTALK_DWS_ROLE_TYPES=creator,executor,participant
# Native 1:1 quote is unavailable for bots. Enable the user-identity dws path.
DINGTALK_USER_REPLY_ENABLED=false

# ---- WeCom ----
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CONTACT_SECRET=
WECOM_AIBOT_ID=
WECOM_AIBOT_SECRET=
WECOM_REDIRECT_URI=http://127.0.0.1:8000/api/auth/wecom/callback
WECOM_AIBOT_ONLY=false
